{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dls://schemas/reviewir/v2",
  "title": "DLS ReviewIR v2",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "change_id",
    "base_sha",
    "comparison_base_sha",
    "head_sha",
    "pack_digest",
    "definition_digest",
    "review_mode",
    "verdict",
    "lanes",
    "ticket_verdicts",
    "prior_finding_verdicts",
    "findings"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "runner_contract": { "enum": ["dls-review-runner/v1", "dls-review-runner/v2"] },
    "context_contract": { "const": "dls-review-context/v2" },
    "economy_contract": { "const": "dls-review-economy/v1" },
    "native_output_contract": { "const": "dls-native-review/v2" },
    "native_workspace_contract": { "const": "dls-native-workspace/v1" },
    "identifier_contract": { "const": "canonical-ticket-ids/v1" },
    "decision_repair_contract": { "const": "dls-decision-repair/v1" },
    "review_id": { "type": "string", "minLength": 1 },
    "change_id": { "type": "string", "minLength": 1 },
    "base_sha": { "type": "string", "minLength": 1 },
    "epic_base_sha": { "type": "string", "minLength": 1 },
    "comparison_base_sha": { "type": "string", "minLength": 1 },
    "head_sha": { "type": "string", "minLength": 1 },
    "pack_digest": { "type": "string", "minLength": 1 },
    "definition_digest": { "type": "string", "minLength": 1 },
    "review_mode": { "enum": ["full", "remediation"] },
    "verdict": { "enum": ["review-clear", "not-clear", "blocked"] },
    "summary": { "type": "string" },
    "lanes": {
      "type": "object",
      "required": ["semantic"],
      "properties": {
        "native": {
          "type": "object",
          "required": [
            "status",
            "attempt_id",
            "model",
            "reasoning_effort",
            "output_path",
            "output_digest",
            "source_snapshot_digest",
            "coverage_chain"
          ],
          "properties": {
            "status": { "const": "completed" },
            "attempt_id": { "type": "string", "minLength": 1 },
            "operation_id": { "type": "string", "minLength": 1 },
            "model": { "const": "gpt-5.6-terra" },
            "reasoning_effort": { "const": "high" },
            "prompt_path": { "type": "string", "minLength": 1 },
            "prompt_digest": { "type": "string", "minLength": 1 },
            "schema_path": { "type": "string", "minLength": 1 },
            "schema_digest": { "type": "string", "minLength": 1 },
            "context_manifest_path": { "type": "string", "minLength": 1 },
            "context_digest": { "type": "string", "minLength": 1 },
            "output_path": { "type": "string", "minLength": 1 },
            "output_digest": { "type": "string", "minLength": 1 },
            "transcript_path": { "type": "string", "minLength": 1 },
            "transcript_digest": { "type": "string", "minLength": 1 },
            "source_snapshot_digest": { "type": "string", "minLength": 1 },
            "coverage_chain": { "type": "array", "minItems": 1 }
          },
          "additionalProperties": true
        },
        "semantic": {
          "type": "object",
          "required": [
            "status",
            "model",
            "reasoning_effort",
            "context_manifest_path",
            "context_manifest_digest",
            "independent_draft_path",
            "independent_draft_digest",
            "passes"
          ],
          "properties": {
            "status": { "const": "completed" },
            "model": { "enum": ["gpt-5.6-sol", "gpt-5.6-terra"] },
            "reasoning_effort": { "enum": ["high", "xhigh"] },
            "context_manifest_path": { "type": "string", "minLength": 1 },
            "context_manifest_digest": { "type": "string", "minLength": 1 },
            "independent_draft_path": { "type": "string", "minLength": 1 },
            "independent_draft_digest": { "type": "string", "minLength": 1 },
            "passes": {
              "type": "array",
              "minItems": 1,
          "maxItems": 3,
              "items": {
                "type": "object",
                "required": ["kind", "status", "draft_path", "draft_digest"],
                "properties": {
                  "kind": { "enum": ["full", "targeted", "final-full"] },
                  "status": { "const": "completed" },
                  "attempt_id": { "type": "string", "minLength": 1 },
                  "operation_id": { "type": "string", "minLength": 1 },
                  "draft_path": { "type": "string", "minLength": 1 },
                  "draft_digest": { "type": "string", "minLength": 1 },
                  "transcript_path": { "type": "string", "minLength": 1 },
                  "transcript_digest": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": true
              }
            },
            "repairs": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "required": [
                  "contract",
                  "source_lane_key",
                  "original_attempt_id",
                  "original_output_digest",
                  "error_code",
                  "error_digest",
                  "input_bundle_digest",
                  "repair_attempt_id",
                  "repair_output_digest",
                  "model",
                  "reasoning_effort",
                  "started_at",
                  "completed_at",
                  "transcript_digest"
                ],
                "properties": {
                  "contract": { "const": "dls-decision-repair/v1" },
                  "source_lane_key": { "type": "string", "minLength": 1 },
                  "original_attempt_id": { "type": "string", "minLength": 1 },
                  "original_output_digest": { "type": "string", "minLength": 1 },
                  "error_code": { "type": "string", "minLength": 1 },
                  "error_digest": { "type": "string", "minLength": 1 },
                  "input_bundle_digest": { "type": "string", "minLength": 1 },
                  "repair_attempt_id": { "type": "string", "minLength": 1 },
                  "repair_output_digest": { "type": "string", "minLength": 1 },
                  "model": { "const": "gpt-5.6-sol" },
                  "reasoning_effort": { "enum": ["high", "xhigh"] },
                  "started_at": { "type": "string", "minLength": 1 },
                  "completed_at": { "type": "string", "minLength": 1 },
                  "transcript_digest": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": true
        },
        "reconciliation": {
          "type": "object",
          "required": [
            "status",
            "attempt_id",
            "operation_id",
            "model",
            "reasoning_effort",
            "prompt_path",
            "prompt_digest",
            "schema_path",
            "schema_digest",
            "output_path",
            "output_digest",
            "transcript_path",
            "transcript_digest",
            "source_snapshot_digest"
          ],
          "properties": {
            "status": { "const": "completed" },
            "attempt_id": { "type": "string", "minLength": 1 },
            "operation_id": { "type": "string", "minLength": 1 },
            "model": { "const": "gpt-5.6-sol" },
            "reasoning_effort": { "enum": ["high", "xhigh"] },
            "prompt_path": { "type": "string", "minLength": 1 },
            "prompt_digest": { "type": "string", "minLength": 1 },
            "schema_path": { "type": "string", "minLength": 1 },
            "schema_digest": { "type": "string", "minLength": 1 },
            "output_path": { "type": "string", "minLength": 1 },
            "output_digest": { "type": "string", "minLength": 1 },
            "transcript_path": { "type": "string", "minLength": 1 },
            "transcript_digest": { "type": "string", "minLength": 1 },
            "source_snapshot_digest": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        "specialists": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["lens_id", "status", "draft_path", "draft_digest"],
            "properties": {
              "lens_id": { "type": "string", "minLength": 1 },
              "status": { "const": "completed" },
              "attempt_id": { "type": "string", "minLength": 1 },
              "operation_id": { "type": "string", "minLength": 1 },
              "model": { "const": "gpt-5.6-terra" },
              "reasoning_effort": { "const": "high" },
              "prompt_path": { "type": "string", "minLength": 1 },
              "prompt_digest": { "type": "string", "minLength": 1 },
              "schema_path": { "type": "string", "minLength": 1 },
              "schema_digest": { "type": "string", "minLength": 1 },
              "output_path": { "type": "string", "minLength": 1 },
              "output_digest": { "type": "string", "minLength": 1 },
              "transcript_path": { "type": "string", "minLength": 1 },
              "transcript_digest": { "type": "string", "minLength": 1 },
              "source_snapshot_digest": { "type": "string", "minLength": 1 },
              "draft_path": { "type": "string", "minLength": 1 },
              "draft_digest": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "ticket_verdicts": { "type": "array" },
    "prior_finding_verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "verdict", "evidence"],
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "verdict": {
            "enum": ["verified", "still-open", "regressed", "waived"]
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "replacement_finding_id": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "findings": { "type": "array" },
    "identifier_normalizations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "field", "source", "canonical", "rule"],
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "field": { "const": "ticket_ids" },
          "source": { "type": "string", "minLength": 1 },
          "canonical": { "type": "string", "minLength": 1 },
          "rule": { "const": "unique-ticket-alias" }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runner_contract": { "const": "dls-review-runner/v1" }
        },
        "required": ["runner_contract"]
      },
      "then": {
        "properties": {
          "lanes": {
            "required": ["semantic", "reconciliation"]
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
