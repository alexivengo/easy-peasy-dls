{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dls://schemas/approval/v1",
  "title": "DLS approval",
  "type": "object",
  "required": [
    "id",
    "decision",
    "object_digest",
    "actor",
    "authority",
    "recorded_at",
    "status"
  ],
  "properties": {
    "id": { "type": "string" },
    "decision": {
      "enum": [
        "definition",
        "accept",
        "exception",
        "design",
        "architecture",
        "revoke"
      ]
    },
    "object_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decision_contract": {
      "enum": ["dls-design-digest/v1", "dls-architecture-digest/v1"]
    },
    "decision_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decision_snapshots_contract": { "const": "dls-definition-decisions/v1" },
    "design_decision_digest": {
      "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"
    },
    "architecture_decision_digest": {
      "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"
    },
    "approval_bundle_contract": { "const": "dls-approval-bundle/v1" },
    "approval_bundle_id": { "type": "string", "format": "uuid" },
    "git_sha": { "type": ["string", "null"] },
    "actor": { "enum": ["codex", "user"] },
    "authority": { "const": "user" },
    "recorded_at": { "type": "string" },
    "status": {
      "enum": ["current", "stale", "superseded", "revoked"]
    }
  },
  "additionalProperties": true
}
