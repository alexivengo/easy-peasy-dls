{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dls://schemas/approval/v1",
  "title": "DLS approval",
  "type": "object",
  "required": [
    "id",
    "decision",
    "object_digest",
    "actor",
    "authority",
    "recorded_at",
    "status"
  ],
  "properties": {
    "id": { "type": "string" },
    "decision": {
      "enum": [
        "definition",
        "accept",
        "exception",
        "design",
        "architecture",
        "revoke"
      ]
    },
    "object_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "git_sha": { "type": ["string", "null"] },
    "actor": { "enum": ["codex", "user"] },
    "authority": { "const": "user" },
    "recorded_at": { "type": "string" },
    "status": {
      "enum": ["current", "stale", "superseded", "revoked"]
    }
  },
  "additionalProperties": true
}
