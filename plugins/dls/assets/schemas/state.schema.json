{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dls://schemas/state/v1",
  "title": "DLS state",
  "type": "object",
  "required": [
    "schema_version",
    "state_revision",
    "change_id",
    "work_kind",
    "control_level",
    "phase",
    "lifecycle",
    "artifacts",
    "approvals",
    "tickets",
    "reviews",
    "finding_dispositions",
    "evidence",
    "operations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "state_revision": { "type": "integer", "minimum": 1 },
    "change_id": { "type": "string", "minLength": 1 },
    "work_kind": {
      "enum": ["feature", "bug", "chore", "spike", "hotfix"]
    },
    "control_level": {
      "enum": ["routine", "standard", "critical"]
    },
    "impact_tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "adopted": { "type": "boolean" },
    "requirement_prefixes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]{0,15}$"
      },
      "uniqueItems": true
    },
    "phase": { "type": "string" },
    "lifecycle": { "type": "string" },
    "definition_digest_contract": {
      "const": "dls-definition-digest/v2"
    },
    "design_source": {
      "type": "object",
      "required": ["contract", "tier", "surfaces", "mode", "source", "bypass"],
      "properties": {
        "contract": { "const": "dls-design-source/v1" },
        "tier": { "enum": [1, 2, 3] },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "uniqueItems": true
        },
        "mode": { "enum": ["source", "bypass"] },
        "source": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["kind", "ref", "version", "content_digest", "git_blob"],
              "properties": {
                "kind": { "enum": ["precedent", "artifact", "external-version"] },
                "ref": { "type": "string", "minLength": 1, "maxLength": 2048 },
                "version": { "type": "string", "minLength": 1, "maxLength": 512 },
                "content_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "git_blob": {
                  "type": ["string", "null"],
                  "pattern": "^[0-9a-f]{40,64}$"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "bypass": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["rationale", "ux_risk"],
              "properties": {
                "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
                "ux_risk": { "enum": ["low", "medium", "high"] }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": { "enum": ["definition", "execution"] }
        },
        "additionalProperties": true
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "definition_digest_contract": {
            "const": "dls-definition-digest/v2"
          },
          "decision_contract": {
            "enum": ["dls-design-digest/v1", "dls-architecture-digest/v1"]
          },
          "decision_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "decision_snapshots_contract": { "const": "dls-definition-decisions/v1" },
          "design_decision_digest": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "architecture_decision_digest": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": true
      }
    },
    "tickets": { "type": "object" },
    "reviews": { "type": "array" },
    "candidate_runs": { "type": "array" },
    "dependencies": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "change_id",
          "blocks_stage",
          "requires",
          "target_definition_digest",
          "rationale"
        ],
        "properties": {
          "change_id": { "type": "string", "minLength": 1 },
          "blocks_stage": {
            "enum": ["definition", "implementation", "review", "acceptance"]
          },
          "requires": {
            "enum": [
              "definition-approved",
              "review-clear",
              "accepted",
              "accepted-in-base"
            ]
          },
          "target_definition_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "recorded_at": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "finding_dispositions": { "type": "array" },
    "evidence": { "type": "array" },
    "operations": { "type": "array" }
  },
  "additionalProperties": true
}
