{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dls://schemas/remediation/v2",
  "title": "DLS remediation manifest v2",
  "type": "object",
  "required": [
    "schema_version",
    "dls_version",
    "change_id",
    "review_id",
    "review_result_path",
    "review_result_digest",
    "reviewed_head_sha",
    "definition_digest",
    "open_findings",
    "ticket_ids",
    "requirement_ids",
    "affected_paths",
    "blast_radius_triggers",
    "inputs",
    "manifest_digest"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "dls_version": { "type": "string", "minLength": 1 },
    "change_id": { "type": "string", "minLength": 1 },
    "review_id": { "type": "string", "minLength": 1 },
    "review_result_path": { "type": "string", "minLength": 1 },
    "review_result_digest": { "type": "string", "minLength": 1 },
    "reviewed_head_sha": { "type": "string", "minLength": 1 },
    "definition_digest": { "type": "string", "minLength": 1 },
    "open_findings": { "type": "array", "minItems": 1 },
    "ticket_ids": { "type": "array", "items": { "type": "string" } },
    "requirement_ids": { "type": "array", "items": { "type": "string" } },
    "affected_paths": { "type": "array", "items": { "type": "string" } },
    "blast_radius_triggers": { "type": "array", "items": { "type": "string" } },
    "inputs": { "type": "array", "minItems": 1 },
    "manifest_digest": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
