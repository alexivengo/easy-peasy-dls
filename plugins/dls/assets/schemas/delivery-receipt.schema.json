{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dls://schemas/delivery-receipt/v1",
  "title": "DLS Delivery Receipt v1",
  "type": "object",
  "required": [
    "ok",
    "schema_version",
    "contract",
    "receipt_digest",
    "markdown_digest",
    "change_id",
    "title",
    "outcome",
    "state_revision",
    "head_sha",
    "source_clean",
    "control_level",
    "lifecycle",
    "definition",
    "decisions",
    "implementation",
    "validation",
    "review",
    "acceptance",
    "release",
    "production",
    "dependencies",
    "parallelism",
    "next_action",
    "markdown"
  ],
  "properties": {
    "ok": { "const": true },
    "schema_version": { "const": 1 },
    "contract": { "const": "dls-delivery-receipt/v1" },
    "receipt_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "markdown_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "change_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "outcome": { "type": ["string", "null"] },
    "state_revision": { "type": "integer", "minimum": 1 },
    "head_sha": { "type": ["string", "null"] },
    "source_digest": { "type": ["string", "null"] },
    "source_clean": { "type": "boolean" },
    "control_level": { "enum": ["routine", "standard", "critical"] },
    "lifecycle": { "type": "string", "minLength": 1 },
    "definition": { "type": "object" },
    "decisions": {
      "type": "object",
      "required": ["design", "architecture"],
      "properties": {
        "design": { "type": "object" },
        "architecture": { "type": "object" }
      },
      "additionalProperties": false
    },
    "implementation": { "type": "object" },
    "validation": { "type": "object" },
    "review": { "type": "object" },
    "acceptance": { "type": "object" },
    "release": { "type": "object" },
    "production": { "type": "object" },
    "dependencies": { "type": "object" },
    "parallelism": { "type": "object" },
    "next_action": { "type": "object" },
    "markdown": { "type": "string", "maxLength": 4096 },
    "dls_version": { "type": "string" }
  },
  "additionalProperties": false
}
