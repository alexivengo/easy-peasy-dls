{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dls://schemas/specialist-decision/v1",
  "title": "DLS specialist decision",
  "type": "object",
  "required": [
    "lens_id",
    "summary",
    "findings"
  ],
  "properties": {
    "lens_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "kind",
          "location",
          "issue",
          "impact",
          "required_fix",
          "ticket_ids",
          "requirement_ids",
          "blocks",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "blocker",
              "should-fix",
              "note"
            ]
          },
          "kind": {
            "enum": [
              "defect",
              "validation-gap",
              "governance",
              "external",
              "design"
            ]
          },
          "location": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "required_fix": {
            "type": "string"
          },
          "ticket_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "enum": [
                "review",
                "acceptance",
                "release",
                "production"
              ]
            }
          },
          "provenance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
